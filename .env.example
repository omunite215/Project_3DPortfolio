# Copy to `.env.local` and fill in to point the contact form at your own inbox.
# All values are NEXT_PUBLIC_* because EmailJS runs entirely in the browser -
# these identifiers are public by design and are not secrets.
#
# Every variable is optional: with no .env.local the app falls back to the
# original owner's configuration and still builds and runs.

# Canonical origin. Used for metadataBase, OpenGraph URLs, sitemap.xml, robots.txt.
NEXT_PUBLIC_SITE_URL=https://portfoliobyompatel.netlify.app

# https://dashboard.emailjs.com/admin
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
